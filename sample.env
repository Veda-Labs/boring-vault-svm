ANCHOR_WALLET='PATH_TO_id.json'
ALCHEMY_API_KEY='YOUR_KEY'
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
DEPLOY_PATH="target/deploy/boring_vault_svm.so"

# SPYx vault deployment script options.
# Program IDs default to target/idl addresses generated by anchor build.
# Override them only when targeting already deployed programs.
# EXECUTE="false"
# CONFIRM_SPYX_MINT="false"
# SPYX_RPC_URL="https://api.mainnet-beta.solana.com"
# SPYX_MINT="XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W"
# BORING_VAULT_PROGRAM_ID="VAULT_PROGRAM_ID"
# BORING_QUEUE_PROGRAM_ID="QUEUE_PROGRAM_ID"
# DEPLOYMENT_OUT_DIR="deployments"

# Full fresh-program redeploy flow.
# This generates/syncs new vault and queue program IDs, builds, deploys the
# programs, initializes config PDAs, then deploys the SPYx vault.
# EXECUTE="false"
# CONFIRM_FULL_REDEPLOY="false"
# CONFIRM_PROGRAM_CONFIG_INIT="false"
# DEPLOY_SPYX_VAULT="true"
# FULL_REDEPLOY_WORK_DIR="target/full-redeploy-manual"
# FORCE_NEW_PROGRAM_IDS="false"
# VAULT_PROGRAM_KEYPAIR="target/full-redeploy-manual/program-keypairs/boring_vault_svm-keypair.json"
# QUEUE_PROGRAM_KEYPAIR="target/full-redeploy-manual/program-keypairs/boring_onchain_queue-keypair.json"
# PROGRAM_CONFIG_AUTHORITY="AUTHORITY_PUBKEY"
